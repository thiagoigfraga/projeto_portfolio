---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { Image } from "astro:assets";
import { getImage } from "astro:assets";
import { inferRemoteSize } from "astro:assets";
const processedImage = await getImage({
  src: "https://avatars.githubusercontent.com/u/49455222?v=4",
  inferSize: true,
});
const { width, height } = await inferRemoteSize(
  "https://avatars.githubusercontent.com/u/49455222?v=4"
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <div class="flex space-x-20 overflow-hidden mt-20 mb-32">
        <Image
          src={processedImage.src}
          class="inline size-72 rounded-full ring-white"
          alt="Thiago Fraga"
          width={width}
          height={height}
          loading="eager"
        />
        <div class="flex flex-col justify-center align-center text-align-left">
          <h1 class="text-3xl font-bold">Thiago Fraga 👋🏻</h1>
          <p class="text-lg text-gray-500">
            Cientista da computação<br />Engenheiro de software
          </p>
          <div class="flex space-x-4 mt-2">
            <a
              href="/sobre"
              class="!text-white focus:outline-none bg-purple-700 hover:bg-purple-800 focus:ring-4 focus:ring-purple-300 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-purple-600 dark:hover:bg-purple-700 dark:focus:ring-purple-900 inline-flex items-center justify-center no-underline"
              role="button"
            >
              Sobre mim
            </a>
            <a
              href="/projetos"
              class="!text-white focus:outline-none text-white bg-purple-700 hover:bg-purple-800 focus:ring-4 focus:ring-purple-300 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-purple-600 dark:hover:bg-purple-700 dark:focus:ring-purple-900 inline-flex items-center justify-center"
              role="button"
            >
              Projetos
            </a>
          </div>
        </div>
      </div>
      <Footer />
    </main>
  </body>
</html>
