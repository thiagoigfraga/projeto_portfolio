---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <div class="flex space-x-20 overflow-hidden">
        <img
          alt="Thiago's Photo"
          src="https://avatars.githubusercontent.com/u/49455222?v=4"
          class="inline size-72 rounded-full ring-white"
        />
        <div class="flex flex-col justify-center align-center text-align-left">
          <h1 class="text-3xl font-bold">Thiago Fraga 👋🏻</h1>
          <p class="text-lg text-gray-500">
            Computer Scientist<br />Software Engineer
          </p>
          <button
            type="button"
            class="focus:outline-none text-white bg-purple-700 hover:bg-purple-800 focus:ring-4 focus:ring-purple-300 font-medium rounded-lg text-sm px-5 py-2.5 mb-2 dark:bg-purple-600 dark:hover:bg-purple-700 dark:focus:ring-purple-900
						self-start"
          >
            About me
          </button>
        </div>
      </div>
      <Footer />
    </main>
  </body>
</html>
