---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { Image } from "astro:assets";
import { getImage } from "astro:assets";
import { inferRemoteSize } from "astro:assets";
import Button from "../components/Button.astro";
const processedImage = await getImage({
  src: "https://avatars.githubusercontent.com/u/49455222?v=4",
  inferSize: true,
});
const { width, height } = await inferRemoteSize(
  "https://avatars.githubusercontent.com/u/49455222?v=4"
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <!-- Mudando para flex-col em telas pequenas e ajustando espaçamento -->
      <div
        class="flex flex-col md:flex-row md:space-x-20 space-y-8 md:space-y-0 overflow-hidden mt-10 md:mt-20 mb-16 md:mb-32 items-center md:items-start px-4 md:px-0"
      >
        <!-- Ajustando o tamanho da imagem para telas menores -->
        <Image
          src={processedImage.src || "/placeholder.svg"}
          class="inline size-48 md:size-72 rounded-full ring-white"
          alt="Thiago Fraga"
          width={width}
          height={height}
          loading="eager"
        />
        <!-- Centralizando o texto em telas pequenas -->
        <div class="flex flex-col justify-center text-center md:text-left">
          <h1 class="text-2xl md:text-3xl font-bold">Thiago <span class="align-mobile">Fraga 👋🏻</span></h1>
          <p class="text-lg text-gray-500">
            Cientista da computação<br />Engenheiro de software
          </p>
          <div class="flex space-x-4 mt-2 justify-center md:justify-start">
            <Button href="/sobre" nome="Sobre"/>
            <Button href="/projetos" nome="Projetos"/>
          </div>
        </div>
      </div>
      <Footer />
    </main>
  </body>
</html>

<style>
  /* Estilo para os ícones SVG com efeito de iluminação no hover */
  svg {
    transition: all 0.3s ease;
  }

  svg:hover {
    filter: drop-shadow(0 0 5px var(--purple));
    transform: scale(1.1);
  }

  /* Efeito de brilho para o path dentro do SVG */
  svg:hover path {
    fill: #b366ff; /* Uma cor roxa mais clara/brilhante */
  }

  @media screen and (max-width: 500px){

    .align-mobile {
      margin-left: 5rem;
    }

  }
</style>
