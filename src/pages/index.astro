<style>
  /* Override global main styles for home page */
  main {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Hero section styles */
  .hero-section {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 4rem 4rem;
    min-height: 100vh;
    text-align: center;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4rem;
    max-width: 1400px;
    width: 100%;
  }

  @media (min-width: 768px) {
    .hero-container {
      flex-direction: row;
      text-align: left;
      gap: 8rem;
      justify-content: space-between;
    }
  }

