---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { Image } from "astro:assets";
import { getImage } from "astro:assets";
import { inferRemoteSize } from "astro:assets";
const processedImage = await getImage({
  src: "https://avatars.githubusercontent.com/u/49455222?v=4",
  inferSize: true,
});
const { width, height } = await inferRemoteSize(
  "https://avatars.githubusercontent.com/u/49455222?v=4"
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <!-- Hero Section -->
      <section class="hero-section fade-in-up">
        <div class="hero-container">
          <!-- Profile Image -->
          <div class="profile-image-container">
            <Image
              src={processedImage.src || "/placeholder.svg"}
              class="profile-image"
              alt="Thiago Fraga"
              width={width}
              height={height}
              loading="eager"
            />
          </div>
          <!-- Profile Content -->
          <div class="profile-content">
            <h1 class="hero-title">
              Olá, eu sou o <span class="text-gradient">Thiago Fraga</span> 👋🏻
            </h1>
            <div class="hero-description">
              <p class="hero-subtitle">
                🎓 Cientista da Computação (8º período)<br />
                💻 Desenvolvedor Front-end especializado em React.js<br />
              </p>
              <p class="hero-text">
                Busco oportunidade de estágio para aplicar meus conhecimentos em
                ambiente profissional e continuar evoluindo como desenvolvedor.
              </p>
            </div>
            <div class="hero-buttons">
              <a href="/sobre" class="btn btn-outline">Sobre mim</a>
              <a href="/projetos" class="btn btn-outline">Projetos</a>
            </div>
          </div>
        </div>
      </section>

      <!-- Skills Section -->
